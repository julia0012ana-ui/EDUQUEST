<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cadastro - Edu Quest</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    min-height:100vh;
    background:linear-gradient(135deg,#0A1128,#001F54,#034078);
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:90%;
    max-width:500px;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(15px);
    padding:35px;
    border-radius:20px;
    box-shadow:0 0 20px rgba(0,0,0,0.3);
}

h1{
    text-align:center;
    color:white;
    margin-bottom:10px;
}

.sub{
    text-align:center;
    color:#ddd;
    margin-bottom:25px;
}

label{
    display:block;
    color:white;
    margin-bottom:5px;
    margin-top:10px;
}

input, select{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    margin-bottom:10px;
}

.botao{
    width:100%;
    padding:15px;
    border:none;
    border-radius:10px;
    background:#00BFFF;
    color:white;
    font-size:17px;
    font-weight:bold;
    margin-top:10px;
    cursor:pointer;
}

.botao:hover{
    background:#0099cc;
}

#resultado{
    margin-top:20px;
    text-align:center;
    color:#90ee90;
    font-weight:bold;
}

.voltar{
    text-align:center;
    margin-top:20px;
}

.voltar a{
    color:white;
    text-decoration:none;
}

.idGerado{
    margin-top:15px;
    background:white;
    color:#034078;
    padding:15px;
    border-radius:10px;
    font-size:20px;
    font-weight:bold;
}

</style>
</head>

<body>

<div class="container">

<h1>🎓 Edu Quest</h1>

<p class="sub">
Crie sua conta para começar a aprender
</p>

<label>Nome Completo</label>
<input type="text" id="nome">

<label>Turma</label>
<input type="text" id="turma" placeholder="Ex: 2A">

<label>Série</label>
<select id="serie">
<option>6º Ano</option>
<option>7º Ano</option>
<option>8º Ano</option>
<option>9º Ano</option>
<option>1º Ensino Médio</option>
<option>2º Ensino Médio</option>
<option>3º Ensino Médio</option>
</select>

<label>E-mail</label>
<input type="email" id="email" placeholder="Digite seu e-mail">

<label>Senha</label>
<input type="password" id="senha">

<label>Confirmar Senha</label>
<input type="password" id="confirmarSenha">

<button class="botao" onclick="criarConta()">
Criar Conta
</button>

<div id="resultado"></div>

<div class="voltar">
<a href="login-aluno.html">← Voltar para Login</a>
</div>

</div>

<script>

function criarConta(){

    let nome = document.getElementById("nome").value;

    let turma = document.getElementById("turma").value;

    let serie = document.getElementById("serie").value;

    let email = document.getElementById("email").value;

    let senha = document.getElementById("senha").value;

    let confirmar = document.getElementById("confirmarSenha").value;

    if(
        nome === "" ||
        turma === "" ||
        email === "" ||
        senha === ""
    ){

        alert("Preencha todos os campos.");
        return;

    }

    if(senha !== confirmar){

        alert("As senhas não coincidem.");
        return;

    }

    let numero = Math.floor(Math.random() * 999999);

    let idAluno = "EQ-" +
    numero.toString().padStart(6,"0");

    document.getElementById("resultado").innerHTML = `

    ✅ Conta criada com sucesso!

    <div class="idGerado">
        ${idAluno}
    </div>

    Nome: ${nome}<br>
    Turma: ${turma}<br>
    Série: ${serie}<br>
    E-mail: ${email}<br><br>

    Guarde este ID para acessar sua conta.

    `;

}

</script>

</body>
</html>
